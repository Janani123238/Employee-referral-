# --- Database ---
# SQLite (default, fine for demos/small deployments):
DATABASE_URL=sqlite:///./muraai.db
# Postgres example (recommended for production):
# DATABASE_URL=postgresql://muraai:muraai@db:5432/muraai

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Ollama local API (server-side only — never exposed to the browser) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- CORS ---
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# --- First admin account (recommended for production) ---
# If set, this HR/admin account is created automatically on first startup.
# Leave unset and the very first person to register on a fresh deployment
# will be offered the HR role instead (one-time only).
BOOTSTRAP_ADMIN_NAME=Your Name
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password

ENV=production

# --- Password reset ---
# Public URL of the deployed frontend — the reset link emailed to users points here.
FRONTEND_URL=http://localhost:8000
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- SMTP (optional) ---
# If left unset, "forgot password" still works end-to-end, but the reset link
# is only written to the server logs instead of emailed — fine for local dev,
# but set these for a real production deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MuraAI Refer <no-reply@muraai.com>
SMTP_USE_TLS=true


